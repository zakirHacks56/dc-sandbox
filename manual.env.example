# Copy to manual.env and fill in. THIS FILE IS IGNORED BY GIT - never commit it.

# Your PERSONAL Telegram bot token (create one with @BotFather -> /newbot)
# This must be DIFFERENT from the cloud controller's bot so the two never
# steal each other's getUpdates offset.
MANUAL_BOT_TOKEN=

# Your own Telegram numeric chat id (talk to @userinfobot to get it)
TELEGRAM_ALLOWED_IDS=

# OpenRouter key (used when the local OmniRoute gateway is NOT running).
# Same key the cloud already uses; free-tier models cost nothing.
LLM_API_KEY=

# A GitHub PAT with the repos listed in config/targets.json
GITHUB_TOKEN=