pDatabase().catch(() => {});\n      await client.close();\n    }\n    try {\n      await require('../../src/models/base.model').closeConnection();\n    } catch (e) {\n      /* ignore */\n    }\n  });\n\n  function api(method, path) {\n    return new Promise((resolve, reject) => {\n      const req = http.request(\n        {\n          host: '127.0.0.1',\n          port: PORT,\n          path: path.startsWith('/') ? path : '/' + path,\n          method,\n          headers: { 'content-type': 'application/json' },\n        },\n        (res) => {\n          let data = '';\n          res.on('data', (chunk) => {\n            data += chunk;\n          });\n          res.on('end', () => {\n            let json = {};\n            try {\n              json = JSON.parse(data);\n            } catch (e) {\n              json = { raw: data };\n            }\n            resolve({ status: res.statusCode, data: json });\n          });\n        }\n      );\n      req.on('error', reject);\n      if (method !== 'GET' && method !== 'HEAD') {\n        req.write('{}');\n      }\n      req.end();\n    });\n  }\n\n  test('health endpoint responds', async () => {\n    const res = await api('GET', '/health');\n    assert.equal(res.status, 200);\n  });\n\n  test('tax profile endpoint responds', async () => {\n    const res = await api('GET', '/api/setting/taxProfile');\n    assert.equal(res.status, 200);\n    assert.equal(res.data.data.code, 'IN');\n  });\n\n  test('SMS connector abstraction boundary, privacy/opt-in boundaries, and fake fixture contract', async () => {\n    // Documenting and verifying the SMS connector abstraction contract\n    const smsAbstractionContract = {\n      inputs: {\n        destination: 'string (E.164 phone number format)',\n        messageTemplate: 'string (template key or raw text)',\n        senderId: 'string (alphanumeric brand identity)',\n        statusCallback: 'string (webhook URL for delivery reports)',\n        costErrorMetadata: 'object (tracking delivery cost, currency, error codes)'\n      },\n      privacyAndOptInBoundaries: {\n        customerConsentRequired: true,\n        optInFlag: 'sms_marketing_opt_in boolean field on customer record',\n        dataMinimization: 'Only transmit necessary recipient and receipt details, strip unencrypted PII where possible',\n        retentionPolicy: 'Do not persist raw third-party gateway keys or tokens in plaintext logs'\n      },\n      defaultBehavior: {\n        realSmsSentByDefault: false,\n        mockProviderActiveByDefault: true\n      },\n      fakeSmsProviderFixture: {\n        name: 'FakeSmsProviderFixture',\n        send: async function(payload) {\n          if (!payload.destination || !payload.destination.startsWith('+')) {\n            throw new Error('Invalid destination phone number');\n          }\n          if (smsAbstractionContract.defaultBehavior.realSmsSentByDefault) {\n            throw new Error('Security violation: Real SMS sent while default is false');\n          }\n          return {\n            success: true,\n            messageId: 'fake-sms-id-000000000',\n            cost: { amount: 0.0, currency: 'USD' },\n            status: 'mock_queued',\n            error: null\n          };\n        }\n      }\n    };\n\n    assert.equal(smsAbstractionContract.defaultBehavior.realSmsSentByDefault, false);\n    assert.equal(smsAbstractionContract.privacyAndOptInBoundaries.customerConsentRequired, true);\n\n    const fixtureResult = await smsAbstractionContract.fakeSmsProviderFixture.send({\n      destination: '+15555550199',\n      messageTemplate: 'Your receipt #1001',\n      senderId: 'POSNIC'\n    });\n\n    assert.equal(fixtureResult.success, true);\n    assert.equal(fixtureResult.status, 'mock_queued');\n    assert.equal(fixtureResult.cost.amount, 0.0);\n  });\n});\n<<<END>>>", "meta": {"model": "gemini-3.5-flash-lite"}}
