{
  "comment": "Provider registry. No secrets here -- api keys always come from the env vars named in key_env. role: coder (strong coding nilm path) / planner (cheap fast) / background (slow orderly) / overflow (last-resort pool, never the default). reset_kind: utc_midnight | pacific_midnight (gemini) | rolling (24h window) | daily (calendar-day reset) | monthly (calendar-month reset) | probe (unknown -> re-probe). Budget fields (all optional, per-provider ceilings): rpm (requests per rolling minute), rps (requests per rolling second), daily_tokens, daily_tokens_in (input-only), daily_neurons (Cloudflare Workers AI neurons), monthly_tokens. models = NATIVE ids only; empty means accept anything that passes resolve_model (openrouter-style funnels).",
  "providers": [
    {
      "name": "nvidia_nim",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "key_env": "NVIDIA_API_KEY",
      "key_env_alt": "NVIDIA_NIM_API_KEY",
      "role": ["coder"],
      "models": [],
      "default_model": "nvidia/llama-3.1-nemotron-70b-instruct",
      "rpm": 40,
      "reset_kind": "rolling",
      "max_tokens_cap": null,
      "max_input_tokens": 200000
    },
    {
      "name": "cloudflare_workers_ai",
      "base_url": "",
      "comment": "Does NOT speak the OpenAI schema natively; llm_router carries a translate adapter (fixer/llm_router.py). URL is built from CF_ACCOUNT_ID: https://api.cloudflare.com/client/v4/accounts/{CF_ACCOUNT_ID}/ai/v1 -- the token alone is not enough.",
      "adapter": "cloudflare_workers_ai",
      "key_env": "CF_API_TOKEN",
      "role": ["planner"],
      "models": [],
      "default_model": "@cf/meta/llama-3.1-8b-instruct",
      "daily_neurons": 10000,
      "reset_kind": "daily",
      "max_tokens_cap": null,
      "max_input_tokens": 128000
    },
    {
